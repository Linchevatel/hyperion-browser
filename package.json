{
  "name": "hyperion-desktop",
  "version": "1.0.4",
  "description": "Hyperion Anti-detect Multibrowser Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mwl --publish never",
    "dist:linux": "electron-builder --linux AppImage deb rpm --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "download:engine": "node scripts/download_engine.js"
  },
  "keywords": [
    "antidetect",
    "browser",
    "multilogin",
    "privacy",
    "fingerprint",
    "chromium"
  ],
  "author": "Linchevatel <295051633+Linchevatel@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.50.0"
  },
  "build": {
    "appId": "com.hyperion.browser",
    "productName": "Hyperion Browser",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Linchevatel <295051633+Linchevatel@users.noreply.github.com>",
      "category": "Network;WebBrowser;",
      "icon": "assets/icons"
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.png",
      "!*.jpg",
      "!run_full_antidetect_audit.js",
      "!test_buttons.js",
      "!verify_antidetect.js",
      "!bundle/**"
    ],
    "extraResources": [
      {
        "from": "bundle/chrome",
        "to": "chrome",
        "filter": [
          "**/*"
        ]
      }
    ],
    "executableName": "hyperion-browser"
  }
}
