{
  "name": "hyperion-desktop",
  "version": "1.0.0",
  "description": "Hyperion Anti-detect Multibrowser Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mwl --publish never",
    "dist:linux": "electron-builder --linux AppImage deb rpm --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "keywords": [
    "antidetect",
    "browser",
    "multilogin",
    "privacy",
    "fingerprint",
    "chromium"
  ],
  "author": "Linchevatel",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.50.0"
  },
  "build": {
    "appId": "com.hyperion.browser",
    "productName": "Hyperion Browser",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;WebBrowser;",
      "icon": "assets/icon.png"
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.png",
      "!*.jpg",
      "!run_full_antidetect_audit.js",
      "!test_buttons.js",
      "!verify_antidetect.js"
    ]
  }
}
