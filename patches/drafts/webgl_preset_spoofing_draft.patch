+// [Hyperion Antidetect Patch] Immutable, process-wide preset data only.
+// Do not cache WTF Strings, Oilpan objects, or V8 handles here: OffscreenCanvas
+// may query WebGL from workers as well as from the renderer main thread.
+struct HyperionWebGLPresetCache {
+  HyperionWebGLPresetCache() {
+    const auto* command_line = base::CommandLine::ForCurrentProcess();
+    if (!command_line ||
+        !command_line->HasSwitch("fingerprint-webgl-preset-b64")) {
+      return;
+    }
+    const std::string encoded =
+        command_line->GetSwitchValueASCII("fingerprint-webgl-preset-b64");
+    if (encoded.size() > 2 * 1024 * 1024)
+      return;
+    std::string json;
+    // Command-line transport avoids file I/O in sandboxed renderers.
+    if (!base::Base64UrlDecode(encoded,
+                               base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                               &json) ||
+        json.size() > 1024 * 1024) {
+      return;
+    }
+    auto parsed = base::JSONReader::Read(json, base::JSON_PARSE_RFC, 32);
+    if (parsed && parsed->is_dict())
+      root = std::move(parsed);
+  }
+
+  std::optional<base::Value> root;
+};
+
+const base::DictValue* HyperionWebGLSection(bool webgl2) {
+  // C++ local-static initialization is synchronized, including worker callers.
+  static const base::NoDestructor<HyperionWebGLPresetCache> cache;
+  return cache->root
+             ? cache->root->GetDict().FindDict(webgl2 ? "webgl2" : "webgl1")
+             : nullptr;
+}
+
+const base::ListValue* HyperionWebGLExtensions(bool webgl2) {
+  const auto* section = HyperionWebGLSection(webgl2);
+  const auto* list = section ? section->FindList("extensions") : nullptr;
+  if (!list)
+    return nullptr;
+  // A malformed list disables masking, whereas [] deliberately hides all.
+  for (const auto& entry : *list) {
+    const auto* name = entry.GetIfString();
+    if (!name || name->empty() || !base::IsStringASCII(*name))
+      return nullptr;
+  }
+  return list;
+}
+
+bool HyperionWebGLExtensionAllowed(bool webgl2, const String& name) {
+  const auto* list = HyperionWebGLExtensions(webgl2);
+  if (!list)
+    return true;
+  for (const auto& entry : *list) {
+    if (DeprecatedEqualIgnoringCase(name, String::FromUtf8(entry.GetString())))
+      return true;
+  }
+  return false;
+}
+
+std::optional<double> HyperionWebGLNumber(const base::Value& value) {
+  auto number = value.GetIfDouble();
+  return number && std::isfinite(*number) ? number : std::nullopt;
+}
+
+// JSONReader represents integers outside signed int32 as doubles. In particular
+// 4294967295 must not go through GetInt() or a signed narrowing cast.
+template <typename T>
+std::optional<T> HyperionWebGLInteger(const base::Value& value) {
+  auto number = HyperionWebGLNumber(value);
+  if (!number || std::trunc(*number) != *number ||
+      *number < static_cast<double>(std::numeric_limits<T>::lowest()) ||
+      *number > static_cast<double>(std::numeric_limits<T>::max())) {
+    return std::nullopt;
+  }
+  return static_cast<T>(*number);
+}
