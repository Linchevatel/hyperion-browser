+      // and out-of-range conversion to int64_t/uint64_t.
+      if (auto number = HyperionWebGLNumber(*value)) {
+        return ScriptValue(
+            script_state->GetIsolate(),
+            v8::Number::New(script_state->GetIsolate(), *number));
+      }
+    }
+  }
