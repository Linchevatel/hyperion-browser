+ScriptValue WebGLRenderingContextBase::ApplyWebGLPresetParameter(
+    ScriptState* script_state,
+    GLenum pname,
+    ScriptValue native_value) {
+  // Null also represents invalid enums and unbound WebGL objects.
+  const auto native = native_value.V8Value();
+  if (native.IsEmpty() || native->IsNullOrUndefined())
+    return native_value;
+
+  // [Hyperion Antidetect Patch] Legacy unmasked flags win over the preset.
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line &&
+      ((pname == WebGLDebugRendererInfo::kUnmaskedRendererWebgl &&
+        command_line->HasSwitch("fingerprint-webgl-renderer")) ||
+       (pname == WebGLDebugRendererInfo::kUnmaskedVendorWebgl &&
+        command_line->HasSwitch("fingerprint-webgl-vendor")))) {
+    return native_value;
+  }
+  const auto* section = HyperionWebGLSection(IsWebGL2());
+  const auto* parameters = section ? section->FindDict("parameters") : nullptr;
+  const auto* entry =
+      parameters ? parameters->FindDict(base::NumberToString(pname)) : nullptr;
+  if (entry) {
+    if (auto override_value =
+            HyperionWebGLParameter(script_state, *entry, native_value)) {
+      return *override_value;
+    }
+  }
+  return native_value;
+}
