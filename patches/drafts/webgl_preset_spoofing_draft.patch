+    if (const auto* text = value->GetIfString())
+      return WebGLAny(script_state, String::FromUtf8(*text));
+  } else if (*type == "bool" && native->IsBoolean()) {
+    if (auto boolean = value->GetIfBool())
+      return WebGLAny(script_state, *boolean);
+  } else if (native->IsNumber()) {
+    if (*type == "int") {
+      if (auto integer = HyperionWebGLInteger<int>(*value))
+        return WebGLAny(script_state, *integer);
+    } else if (*type == "uint") {
+      if (auto integer = HyperionWebGLInteger<unsigned>(*value))
+        return WebGLAny(script_state, *integer);
+    } else if (*type == "float") {
+      if (auto number = HyperionWebGLNumber(*value)) {
+        if (std::abs(*number) <= std::numeric_limits<float>::max())
+          return WebGLAny(script_state, static_cast<float>(*number));
