+  const auto* list = value->GetIfList();
+  if (!list || list->size() > 4096)
+    return std::nullopt;
+  if (*type == "intvec" && native->IsInt32Array()) {
+    if (list->size() != native.As<v8::Int32Array>()->Length())
+      return std::nullopt;
+    Vector<int32_t> values;
+    for (const auto& item : *list) {
+      auto integer = HyperionWebGLInteger<int32_t>(item);
+      if (!integer)
+        return std::nullopt;
+      values.push_back(*integer);
+    }
+    return WebGLAny(script_state, DOMInt32Array::Create(values));
+  }
+  if (*type == "uintvec" && native->IsUint32Array()) {
+    // COMPRESSED_TEXTURE_FORMATS may have a different number of formats.
+    Vector<uint32_t> values;
+    for (const auto& item : *list) {
+      auto integer = HyperionWebGLInteger<uint32_t>(item);
+      if (!integer)
+        return std::nullopt;
+      values.push_back(*integer);
+    }
+    return WebGLAny(script_state, DOMUint32Array::Create(values));
+  }
+  if (*type == "floatvec" && native->IsFloat32Array()) {
+    if (list->size() != native.As<v8::Float32Array>()->Length())
+      return std::nullopt;
+    Vector<float> values;
+    for (const auto& item : *list) {
+      auto number = HyperionWebGLNumber(item);
+      if (!number || std::abs(*number) > std::numeric_limits<float>::max())
+        return std::nullopt;
+      values.push_back(static_cast<float>(*number));
+    }
+    return WebGLAny(script_state, DOMFloat32Array::Create(values));
+  }
+  if (*type == "boolvec" && native->IsArray()) {
+    // The native WebGL boolean sequence is COLOR_WRITEMASK (four elements).
+    if (list->size() != 4 || native.As<v8::Array>()->Length() != 4)
+      return std::nullopt;
+    std::array<bool, 4> values;
+    for (size_t i = 0; i < values.size(); ++i) {
+      auto boolean = (*list)[i].GetIfBool();
+      if (!boolean)
+        return std::nullopt;
+      values[i] = *boolean;
+    }
+    return WebGLAny(script_state, base::span<const bool>(values));
+  }
+  return std::nullopt;
+}
